{
  "name": "elo-league",
  "version": "0.0.0",
  "private": true,
  "description": "A league platform for eFootball players",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  
  "lint-staged": {
  "*.js": ["eslint --fix", "prettier --write"],
  "*.{json,md,yml,yaml,css,html}": ["prettier --write --ignore-unknown"]
},

  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9"
  }
}
