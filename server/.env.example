# Core
NODE_ENV=development
PORT=5000
APP_NAME=Elo League
CLIENT_URL=http://localhost:5173
TIMEZONE=Asia/Dhaka

# Database (Atlas example: mongodb+srv://<user>:<password>@<cluster>/elo_league?retryWrites=true&w=majority)
MONGO_URI=mongodb://127.0.0.1:27017/elo_league

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Auth
# Required in production, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12
# Failed sign-ins allowed per IP every 10 minutes
LOGIN_RATE_LIMIT_MAX=20

# First admin, used by `npm run seed:admin`. Choose your own password: 10+ characters,
# at least one letter and one number. The admin must change it at first sign-in.
ADMIN_NAME=League Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@eloleague.local
ADMIN_PASSWORD=
