# Core
NODE_ENV=development
PORT=5000
APP_NAME=Elo League
CLIENT_URL=http://localhost:5173
TIMEZONE=Asia/Dhaka

# Database (Atlas example: mongodb+srv://<user>:<password>@<cluster>/elo_league?retryWrites=true&w=majority)
MONGO_URI=mongodb://127.0.0.1:27017/elo_league

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
